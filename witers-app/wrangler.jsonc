{
  "$schema": "node_modules/wrangler/config-schema.json",

  // WITERS — standalone Cloudflare Workers config.
  // Before the first deploy:
  //   1. npx wrangler login
  //   2. npx wrangler d1 create witers-db        → copy database_id below
  //   3. npx wrangler r2 bucket create witers-assets
  //   4. npx wrangler d1 migrations apply witers-db --remote
  //   5. npx wrangler secret put OPENAI_API_KEY  (for AI intake + image generation, optional)
  //   6. npx wrangler secret put ADMIN_EDIT_PIN  (code the admin panel asks for before editing a user)
  //   7. npx wrangler secret put STRIPE_SECRET_KEY  (membership checkout — must match the
  //      mode, test vs live, of STRIPE_PUBLISHABLE_KEY below, or Elements/PaymentIntents fail)
  "name": "witers",

  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files in dist/client serve directly; any non-asset path — incl. "/"
  // — falls through to the SSR Worker. Do NOT set run_worker_first:true.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // There is no shared/default Meta ad account — every client pautas from
  // THEIR OWN ad account. The client adds WITERS's Business Portfolio as a
  // partner (Analyst access) from their own Business Manager; once
  // accepted, that ad account shows up in WITERS's own Business Manager
  // account list, staff copies its id from there, and pastes it into that
  // client's brand profile via the admin panel (see
  // /api/admin/update-brand-profile). The same META_ACCESS_TOKEN (a
  // Secret, not a var — see meta-ads.server.ts) then reads that account
  // too; only the ad account id varies per client, never the token. No
  // per-client Meta OAuth/App Review is involved in this flow.
  //
  // STRIPE_PUBLISHABLE_KEY is here (not a dashboard-only var) because
  // `wrangler deploy` overwrites a Worker's plain-text vars with exactly
  // this object on every deploy — anything added by hand in the Cloudflare
  // dashboard but missing from this list gets silently wiped on the next
  // push. It's meant to be public (ships to the browser) and safe to
  // commit, unlike STRIPE_SECRET_KEY, which stays a dashboard/CLI Secret.
  // It MUST stay paired with whatever mode (test vs live) STRIPE_SECRET_KEY
  // is in — a live pk with a test sk (or vice versa) makes every checkout
  // fail. Local dev overrides this with the test key from .dev.vars, so
  // `wrangler dev` never touches live Stripe.
  "vars": {
    "HF_ENV": "prod",
    "APP_SLUG": "witers",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51TwAPHFJxTCgIYcaf7mdWiLQ8gMow4H3cWHV5v7rccOGunKwz6l8XMjaIa7IWsPvnUlgwTXY7ioKrzA3pEsAhV2a00mAMn6hqP"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "witers-db",
      "database_id": "1637cd44-7a20-4d8b-bc18-6c1214d52d9c"
    }
  ],

  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "witers-assets" }]
}
