{
  "$schema": "node_modules/wrangler/config-schema.json",

  // WITERS — standalone Cloudflare Workers config.
  // Before the first deploy:
  //   1. npx wrangler login
  //   2. npx wrangler d1 create witers-db        → copy database_id below
  //   3. npx wrangler r2 bucket create witers-assets
  //   4. npx wrangler d1 migrations apply witers-db --remote
  //   5. npx wrangler secret put OPENAI_API_KEY  (for AI intake + image generation, optional)
  //   6. npx wrangler secret put ADMIN_EDIT_PIN  (code the admin panel asks for before editing a user)
  "name": "witers",

  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files in dist/client serve directly; any non-asset path — incl. "/"
  // — falls through to the SSR Worker. Do NOT set run_worker_first:true.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // META_AD_ACCOUNT_ID lives here (not as a dashboard-only var) because
  // `wrangler deploy` overwrites a Worker's plain-text vars with exactly
  // this object on every deploy — anything added by hand in the Cloudflare
  // dashboard but missing from this list gets silently wiped on the next
  // push. It's not sensitive (just an ad account number, not a
  // credential), so it's safe to commit; META_ACCESS_TOKEN stays a
  // dashboard/CLI Secret instead, since those persist across deploys and
  // this one actually is sensitive. This is WITERS's own shared ad
  // account — every client's campaign is created here (see
  // meta-ads.server.ts); it is NOT per-client.
  "vars": { "HF_ENV": "prod", "APP_SLUG": "witers", "META_AD_ACCOUNT_ID": "1528358221731960" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "witers-db",
      "database_id": "1637cd44-7a20-4d8b-bc18-6c1214d52d9c"
    }
  ],

  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "witers-assets" }]
}
